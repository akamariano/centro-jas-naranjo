# Copia este archivo a ".env" dentro de /frontend
VITE_API_URL=http://localhost:4000/api

# --- Modo de prueba (sin backend) ---
# Si VITE_APP_MODE=local, el frontend guarda todo en localStorage del navegador
# en vez de llamar a la API. Útil para probar en el teléfono sin desplegar
# backend/base de datos. Deja VITE_APP_MODE sin definir (o en "remote") para
# el comportamiento normal contra el backend real.
# VITE_APP_MODE=local
# VITE_TEST_PASSWORD=jasnaranjo
