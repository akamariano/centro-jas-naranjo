# =====================================================================
# Backend — Centro JAS Naranjo
# Copia este archivo a ".env" dentro de /backend
# =====================================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Base de datos (debe coincidir con docker-compose.yml o tu proveedor) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=cjn_admin
DB_PASSWORD=cambia_esta_clave
DB_NAME=centro_jas_naranjo
# Alternativa: URL completa (usada automáticamente por Render/Supabase). Si se define, tiene prioridad sobre DB_*.
# DATABASE_URL=postgresql://usuario:password@host:5432/basededatos
# Requiere SSL en la mayoría de proveedores gratuitos (Render/Supabase)
DB_SSL=false

# --- JWT / Autenticación de administradores ---
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h
COOKIE_NAME=cjn_token

# --- CORS: dominio exacto del frontend ---
FRONTEND_URL=http://localhost:5173

# --- Cookies seguras (poner en "true" solo detrás de HTTPS, ej. producción) ---
COOKIE_SECURE=false

# --- Carga de fotos de actividades ---
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=5
